{
  "all": true,
  "include": ["src/**/*.{js,jsx,ts,tsx}"],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts",
    "node_modules/**",
    "test/**",
    "dist/**"
  ],
  "reporter": ["html", "text", "lcov", "json"],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "require": [],
  "extension": [".js", ".jsx", ".ts", ".tsx"],
  "check-coverage": false,
  "branches": 50,
  "lines": 50,
  "functions": 50,
  "statements": 50
}

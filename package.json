{
  "name": "pizzashop",
  "version": "1.0.0",
  "description": "The world's first JWT Pizza",
  "main": "index.js",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "playwright test",
    "test:coverage": "npm run clean-coverage && playwright test && nyc report --reporter=text --reporter=json-summary",
    "test:coverage:windows": "npm run clean-coverage && playwright test && nyc report",
    "clean-coverage": "node -e \"const fs = require('fs'); const path = require('path'); ['./coverage', './.nyc_output'].forEach(dir => { if (fs.existsSync(dir)) { fs.rmSync(dir, { recursive: true, force: true }); } });\""
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "nyc": "^17.1.0",
    "playwright-test-coverage": "^1.2.12",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.5.4",
    "vite": "^7.3.1",
    "vite-plugin-istanbul": "^7.2.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.16.0",
    "preline": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3"
  }
}
